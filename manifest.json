{
  "manifest_version": 3,
  "name": "YT AdShield – Chặn quảng cáo YouTube",
  "version": "1.1.0",
  "description": "Chặn quảng cáo YouTube ở lớp dữ liệu, qua mặt cơ chế phát hiện ad-block (kể cả fake buffering). Dùng cho mục đích cá nhân.",
  "minimum_chrome_version": "121",
  "permissions": ["declarativeNetRequest", "storage"],
  "action": {
    "default_title": "YT AdShield – mở cài đặt"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "yt_ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/isolate.js"],
      "run_at": "document_start"
    }
  ]
}
